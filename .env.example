## Zen Mail (.env.example)
## Copy to `.env.local` for development.
## Do NOT commit real secrets.

## ------------------------------------------------------------
## Firebase Web App config (from Firebase Console)
## Project Settings → Your apps → (Web app) → SDK setup and configuration
## ------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_APP_ID"

## ------------------------------------------------------------
## Firebase Admin (Service Account) for server-side token verification
## Firebase Console → Project Settings → Service accounts → Generate new private key
## For Vercel, store private key with literal \\n sequences.
## ------------------------------------------------------------
FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@YOUR_PROJECT_ID.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nREPLACE_ME\\n-----END PRIVATE KEY-----\\n"

## ------------------------------------------------------------
## Worker (external cron calls /api/worker/dispatch)
## ------------------------------------------------------------
WORKER_SECRET="REPLACE_WITH_STRONG_RANDOM"

## ------------------------------------------------------------
## SES webhook ingest (/api/webhooks/ses?tenant_id=...)
## Provide this secret as `x-webhook-secret` header.
## ------------------------------------------------------------
SES_WEBHOOK_SECRET="REPLACE_WITH_STRONG_RANDOM"

## ------------------------------------------------------------
## Encryption + signing
##
## SES_CRED_ENC_KEY (required for SES settings + sending mail)
##   - AES-256-GCM key used to encrypt tenant SES access/secret keys at rest in Firestore.
##   - Value must be standard base64 that decodes to exactly 32 bytes (same as openssl rand -base64 32).
##   - Set this in every environment that runs the app or worker (local, Vercel, cron host, etc.).
##   - Generate once per environment; keep it stable. If you change it, existing ciphertext cannot be
##     decrypted until each tenant re-saves their SES credentials in app/settings/domains-ses.
##   Generate (pick one):
##     openssl rand -base64 32
##     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
##
## TRACKING_SIGNING_KEY
##   - Strong random string used to sign open-tracking pixel URLs (any long random value is fine).
## ------------------------------------------------------------
SES_CRED_ENC_KEY="YOUR_BASE64_32_BYTE_KEY"
TRACKING_SIGNING_KEY="REPLACE_WITH_STRONG_RANDOM"

## Public base URL used to generate open-tracking pixel URLs in emails
PUBLIC_BASE_URL="http://localhost:3000"

