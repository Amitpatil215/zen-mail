rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Writes use path tenantId: only members of that tenant may create/update/delete.
    function isTenantMember(tenantId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid)
        );
    }

    match /tenants/{tenantId}/{allPaths=**} {
      // Public download by URL (read does NOT cover list — see below).
      allow get: if true;
      // Only members can enumerate objects under this tenant prefix.
      allow list: if isTenantMember(tenantId);
      // create, update, delete — never another tenant's prefix.
      allow write: if isTenantMember(tenantId);
    }
  }
}
